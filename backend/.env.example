# Copy to .env and fill in. NEVER commit .env
NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

MONGO_URI=mongodb://localhost:27017/url_shortener
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=1500
ML_RISK_THRESHOLD=0.5

CACHE_TTL_SECONDS=3600
SHORTCODE_LENGTH=7
MAX_CODE_RETRIES=5
CLICK_RETENTION_DAYS=90

ENABLE_RESCANNER=false
RESCAN_CRON=0 3 * * *
TRUST_PROXY=false

# Email OTP (registration verification) -- required, registration will fail without it.
# Gmail: generate an App Password at https://myaccount.google.com/apppasswords
#        (needs 2FA enabled on the Google account; your normal password will NOT work)
  
# SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_USER=apikey
#   SMTP_PASS=<your SendGrid API key>
#   SMTP_FROM=<a verified sender address in your SendGrid account>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_FROM=


# How long the live reachability check waits for the destination to respond

